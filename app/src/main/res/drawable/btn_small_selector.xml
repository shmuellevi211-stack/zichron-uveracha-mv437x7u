<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#0C1626" />
            <stroke android:width="1.5dp" android:color="#D4AF37" />
            <padding android:bottom="6dp" android:left="10dp" android:right="10dp" android:top="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#24375A" />
            <stroke android:width="2dp" android:color="#FFD700" />
            <padding android:bottom="6dp" android:left="10dp" android:right="10dp" android:top="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#1A2A44" />
            <stroke android:width="1dp" android:color="#364968" />
            <padding android:bottom="6dp" android:left="10dp" android:right="10dp" android:top="6dp" />
        </shape>
    </item>
</selector>
