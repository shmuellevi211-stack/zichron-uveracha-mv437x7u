<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#ECC246" />
            <stroke android:width="3dp" android:color="#1A2A44" />
            <padding android:bottom="10dp" android:left="14dp" android:right="14dp" android:top="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#B8860B" />
            <stroke android:width="2dp" android:color="#1A2A44" />
            <padding android:bottom="10dp" android:left="14dp" android:right="14dp" android:top="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#D4AF37" />
            <stroke android:width="1dp" android:color="#B8860B" />
            <padding android:bottom="10dp" android:left="14dp" android:right="14dp" android:top="10dp" />
        </shape>
    </item>
</selector>
