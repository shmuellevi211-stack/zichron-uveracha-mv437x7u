<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#D4AF37" />
            <stroke android:width="1.5dp" android:color="#1A2A44" />
            <padding android:bottom="8dp" android:left="16dp" android:right="16dp" android:top="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#FFF8E1" />
            <stroke android:width="2dp" android:color="#D4AF37" />
            <padding android:bottom="8dp" android:left="16dp" android:right="16dp" android:top="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#ECEEEF" />
            <stroke android:width="1dp" android:color="#CBD3DE" />
            <padding android:bottom="8dp" android:left="16dp" android:right="16dp" android:top="8dp" />
        </shape>
    </item>
</selector>
