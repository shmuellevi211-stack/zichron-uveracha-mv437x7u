<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#B8860B" />
            <stroke android:width="1.5dp" android:color="#FFFFFF" />
            <padding android:bottom="10dp" android:left="16dp" android:right="16dp" android:top="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#D4AF37" />
            <stroke android:width="1.5dp" android:color="#FFECB3" />
            <padding android:bottom="10dp" android:left="16dp" android:right="16dp" android:top="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#2B436D" />
            <stroke android:width="2.5dp" android:color="#FFD700" />
            <padding android:bottom="10dp" android:left="16dp" android:right="16dp" android:top="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#1B2D4A" />
            <stroke android:width="1dp" android:color="#2B426B" />
            <padding android:bottom="10dp" android:left="16dp" android:right="16dp" android:top="10dp" />
        </shape>
    </item>
</selector>
