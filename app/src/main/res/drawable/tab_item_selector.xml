<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#2A436D" />
            <stroke android:width="2.5dp" android:color="#FFD700" />
            <padding android:bottom="8dp" android:left="14dp" android:right="14dp" android:top="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#D4AF37" />
            <stroke android:width="1.5dp" android:color="#B8860B" />
            <padding android:bottom="8dp" android:left="14dp" android:right="14dp" android:top="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#1F3252" />
            <stroke android:width="1dp" android:color="#2D4673" />
            <padding android:bottom="8dp" android:left="14dp" android:right="14dp" android:top="8dp" />
        </shape>
    </item>
</selector>
