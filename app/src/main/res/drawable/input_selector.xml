<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="2.5dp" android:color="#D4AF37" />
            <padding android:bottom="12dp" android:left="14dp" android:right="14dp" android:top="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="1.5dp" android:color="#CBD3DC" />
            <padding android:bottom="12dp" android:left="14dp" android:right="14dp" android:top="12dp" />
        </shape>
    </item>
</selector>
