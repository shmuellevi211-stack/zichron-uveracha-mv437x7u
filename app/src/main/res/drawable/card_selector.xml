<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#F4EFE2" />
            <stroke android:width="2dp" android:color="#D4AF37" />
            <padding android:bottom="14dp" android:left="16dp" android:right="16dp" android:top="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#FFFEF2" />
            <stroke android:width="3dp" android:color="#D4AF37" />
            <padding android:bottom="14dp" android:left="16dp" android:right="16dp" android:top="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#E0DACB" />
            <padding android:bottom="14dp" android:left="16dp" android:right="16dp" android:top="14dp" />
        </shape>
    </item>
</selector>
